{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=Asia/Shanghai"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modalcontextprotocol/server-memory"
      ]
    }
  }
}